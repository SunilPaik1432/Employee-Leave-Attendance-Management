<section class="actions login"><form method="post" asp-action="Login"><h2>Sign in</h2>
@if(ViewData["Error"] is string error){<p role="alert">@error</p>}
<label>Username<input name="login" maxlength="100" autocomplete="username" required></label>
<label>Password<input name="password" type="password" maxlength="128" autocomplete="current-password" required></label>
<button>Sign in</button></form></section>